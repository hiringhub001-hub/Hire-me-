# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# SQLite locally. In production use a Postgres URL (Neon / Supabase) and switch
# the datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Session signing key. Generate one:  openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical origin. Used by metadata, canonicals, sitemap, feeds and emails.
NEXT_PUBLIC_SITE_URL="https://careerhub.com.ng"

# ---------------------------------------------------------------------------
# Email (Resend) — applications and job postings are emailed to the candidate,
# the recruiter and the admin. Without a key, messages are recorded in the
# EmailLog table as QUEUED and logged to the console; nothing breaks.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Must be on a domain you have verified in Resend.
EMAIL_FROM="CareerHub <notifications@careerhub.com.ng>"
# Receives a copy of every application and every new job posting.
ADMIN_EMAIL="admin@careerhub.com.ng"

# ---------------------------------------------------------------------------
# Optional — nothing loads while these are empty
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
