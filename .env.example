# SQLite locally. In production use a Postgres URL (Neon / Supabase) and switch
# the datasource provider in prisma/schema.prisma.
DATABASE_URL="postgresql://neondb_owner:npg_a5uAIy7VDSxM@ep-rapid-lab-ayyit3u0.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"



# Session signing key. Generate one:  openssl rand -base64 32
AUTH_SECRET=  "x/KZv1+hhSixFBhwy7QG2tTyrxkoMB9AUF2P3dZsjdA="

# Canonical origin. Used by metadata, canonicals, sitemap, feeds and emails.
NEXT_PUBLIC_SITE_URL="https://careerhub.com.ng"

# ---------------------------------------------------------------------------
# Email (Resend) — applications and job postings are emailed to the candidate,
# the recruiter and the admin. Without a key, messages are recorded in the
# EmailLog table as QUEUED and logged to the console; nothing breaks.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""  # never commit a real key here — put it in .env and in Vercel
# Must be on a domain you have verified in Resend.
EMAIL_FROM="CareerHub <notifications@careerhub.com.ng>"
# Operator inbox: new jobs, every application, new users, repeated failed logins.
ADMIN_EMAIL="hiringhub001@gmail.com"

# ---------------------------------------------------------------------------
# Optional — nothing loads while these are empty
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_GA_ID="G-3LL6XFCN8B"
NEXT_PUBLIC_CLARITY_ID="y1y2c80bu4"

# Set to "true" to publish recruiter job postings immediately instead of holding
# them for admin review. Leave unset while you want a person to check every
# listing — that review is what keeps fraudulent adverts off the site and is
# part of what AdSense assesses.
AUTO_PUBLISH_JOBS=""
