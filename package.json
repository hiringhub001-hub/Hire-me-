{
  "name": "careerhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma migrate deploy && npm run db:seed",
    "test:e2e": "tsx tests/e2e.ts",
    "db:up": "docker compose up -d && node -e \"setTimeout(()=>{},4000)\"",
    "db:down": "docker compose down",
    "db:deploy": "prisma migrate deploy",
    "test:layout": "tsx tests/layout.ts",
    "check:live": "tsx scripts/check-live.ts",
    "test:seo": "tsx tests/seo.ts",
    "make:admin": "tsx scripts/make-admin.ts",
    "setup:local": "tsx scripts/dev-setup.ts",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "audit:ads": "tsx tests/ads-audit.ts",
    "clean:demo": "tsx scripts/remove-demo-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "next": "^15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.23",
    "fast-xml-parser": "^5.10.1",
    "playwright": "^1.49.1",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
